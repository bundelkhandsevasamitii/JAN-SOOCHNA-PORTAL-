// Search Filter Functionality
const searchInput = document.getElementById("stateSearchInput");
if (searchInput) {
    searchInput.addEventListener("input", function () {
        const query = this.value.toLowerCase().trim();
        const cards = document.querySelectorAll(".state-card");

        cards.forEach(card => {
            const keywords = card.getAttribute("data-name").toLowerCase();
            if (keywords.includes(query)) {
                card.style.display = "flex";
            } else {
                card.style.display = "none";
            }
        });
    });
}

// Open Modal Function (Global scope के लिए window से जोड़ा गया)
window.openStateModal = function (code) {
    const data = stateDetailsData[code];
    if (!data) return;

    document.getElementById("modalTitle").innerText = data.title;
    document.getElementById("modalBody").innerHTML = `
        <p>${data.description}</p>
        <table class="modal-info-table">
            <tr>
                <td>राजधानी:</td>
                <td>${data.capital}</td>
            </tr>
            <tr>
                <td>कुल जिले:</td>
                <td>${data.districts}</td>
            </tr>
            <tr>
                <td>प्रमुख धरोहरें:</td>
                <td>${data.heritage}</td>
            </tr>
        </table>
    `;
    document.getElementById("stateModal").style.display = "flex";
};

// Close Modal Function
window.closeStateModal = function () {
    document.getElementById("stateModal").style.display = "none";
};

// Modal के बाहर क्लिक करने पर बंद करें
window.addEventListener("click", function (e) {
    const modal = document.getElementById("stateModal");
    if (e.target === modal) {
        modal.style.display = "none";
    }
});
